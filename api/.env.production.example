# Production environment for the Room Play API.
#
# Copy to .env on the server and fill in. Never commit the filled-in version —
# it holds the database password and the APP_KEY that decrypts sessions and
# signed URLs.

APP_NAME="Room Play"
APP_ENV=production

# Generate on the server: php artisan key:generate
APP_KEY=

# With this on, any error page prints every value in this file to whoever
# triggered it. It is the most common way a production database password leaks.
APP_DEBUG=false

APP_URL=https://api.example.com
APP_TIMEZONE=UTC

# ---------------------------------------------------------------- database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------- cache
# The login rate limiter lives in the cache. On `array` it resets every
# request, which silently disables the lockout protecting every account.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ----------------------------------------------------------------- broadcast
BROADCAST_CONNECTION=reverb

# Generate fresh values — do NOT reuse the development ones from the local
# .env. The secret signs broadcast authorisation.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# What the server binds to. Loopback only; OpenLiteSpeed proxies to it.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# What the app connects to. Public hostname, TLS, standard port — the phone
# talks to OpenLiteSpeed, never to Reverb directly.
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# ------------------------------------------------------------------- mail
# Password resets go nowhere on the `log` mailer. Real SMTP before real users.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------ logging
LOG_CHANNEL=daily
LOG_LEVEL=warning
