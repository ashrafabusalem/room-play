<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default, and does it silently — the call
  just fails, which looks exactly like the server being down.

  The development API runs over plain HTTP on a local address, so those specific
  hosts are allowed and nothing else is. A blanket
  android:usesCleartextTraffic="true" would permit plaintext to *any* host,
  including a hijacked DNS answer on a public network.

  TODO before release: the production API must be HTTPS, and this file should be
  deleted along with the manifest reference to it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- This machine on the LAN, for testing on a physical phone. -->
        <domain includeSubdomains="false">192.168.0.104</domain>
    </domain-config>
</network-security-config>
