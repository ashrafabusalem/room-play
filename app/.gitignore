# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — an upload key in git means anyone with repo access can
# publish as you, and the key cannot be rotated once Google has it.
*.jks
*.keystore
/android/key.properties

# Golden failure diffs, written by `flutter test` when a screenshot mismatches.
/test/failures/

# Gradle and Xcode build output. Flutter's default ignore only covers the root
# /build/, which misses android/build/ and ios/build/.
android/build/
android/.gradle/
ios/build/
ios/Pods/
